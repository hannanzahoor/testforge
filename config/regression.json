{
  "_comment": [
    "Nightly regression profile: more workers, longer deadlines, one retry for",
    "transient failures, and every report format including JUnit for CI.",
    "Use with: testforge --config config/regression.json run --tag regression"
  ],

  "execution": {
    "workers": 8,
    "default_timeout_ms": 60000,
    "cancellation_grace_ms": 5000,
    "fail_fast": false,
    "retry_failed": 1,
    "shuffle": true,
    "shuffle_seed": 0,
    "exclude_suites_by_default": ["failure_injection"]
  },

  "logging": {
    "level": "info",
    "json": true,
    "color": false,
    "file": "logs/regression.jsonl"
  },

  "database": {
    "enabled": true,
    "path": "testforge.db",
    "retention_days": 180,
    "busy_timeout_ms": 15000
  },

  "reporting": {
    "output_directory": "reports/regression",
    "console": true,
    "json": true,
    "html": true,
    "junit": true,
    "verbose_failures": true
  },

  "api": {
    "base_url": "http://127.0.0.1:8000",
    "timeout_ms": 20000,
    "sla_ms": 3000,
    "default_headers": {
      "Accept": "application/json",
      "X-TestForge-Profile": "regression"
    }
  },

  "ai": {
    "enabled": false,
    "endpoint": "http://127.0.0.1:8810",
    "model": "gpt-4o-mini",
    "timeout_ms": 90000,
    "max_generated_tests": 40,
    "max_response_bytes": 1048576,
    "allowed_target_hosts": []
  },

  "diagnostics": {
    "collect_on_failure": true,
    "include_gpu": true,
    "include_processes": true,
    "include_system_logs": false,
    "top_process_count": 15,
    "command_timeout_ms": 8000
  },

  "server": {
    "host": "127.0.0.1",
    "port": 8080,
    "workers": 4,
    "static_directory": "dashboard",
    "max_request_bytes": 1048576,
    "max_pending_connections": 256
  },

  "custom": {}
}
