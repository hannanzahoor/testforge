# TestForge environment template.
#
# Copy to .env and fill in what you need:
#
#     cp .env.example .env
#
# .env is in .gitignore and must never be committed. Nothing here is required:
# TestForge builds, runs and reports with none of it set — the AI features
# simply report themselves as disabled.
#
# Precedence, lowest to highest:
#   built-in defaults -> config/*.json -> .env -> real environment -> CLI flags
# The real environment always wins over this file, so
# `OPENAI_API_KEY=... testforge ...` behaves the way you would expect.

# ---------------------------------------------------------------------------
# AI (optional)
# ---------------------------------------------------------------------------

# Read only by the Python sidecar. The C++ engine never sees it: it talks to
# the sidecar over plain HTTP on loopback. See docs/ai-architecture.md.
OPENAI_API_KEY=

# Point the sidecar at an OpenAI-compatible endpoint (a local model server, a
# proxy). Leave blank for the default.
OPENAI_BASE_URL=

# Turn the AI features on. With this false, `testforge ai ...` explains that
# they are disabled rather than failing.
TESTFORGE_AI_ENABLED=false
TESTFORGE_AI_ENDPOINT=http://127.0.0.1:8810
TESTFORGE_AI_MODEL=gpt-4o-mini
TESTFORGE_AI_TIMEOUT_MS=60000

# Use the deterministic offline provider instead of a model. Useful for demos
# and CI: no key, no network, identical output every time.
TESTFORGE_AI_MOCK=false

# ---------------------------------------------------------------------------
# System under test
# ---------------------------------------------------------------------------

TESTFORGE_API_BASE_URL=http://127.0.0.1:8000
TESTFORGE_API_TIMEOUT_MS=10000

# The token the sample service's /protected endpoint expects.
SAMPLE_API_TOKEN=testforge-demo-token

# ---------------------------------------------------------------------------
# Execution
# ---------------------------------------------------------------------------

# 0 means "one per CPU".
TESTFORGE_WORKERS=0
TESTFORGE_TIMEOUT_MS=30000
TESTFORGE_FAIL_FAST=false
TESTFORGE_RETRY_FAILED=0

# ---------------------------------------------------------------------------
# Storage and reporting
# ---------------------------------------------------------------------------

TESTFORGE_DB_ENABLED=true
TESTFORGE_DB_PATH=testforge.db
TESTFORGE_REPORT_DIR=reports

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# trace | debug | info | warn | error | off
TESTFORGE_LOG_LEVEL=info

# One JSON object per line on stderr, for log collectors.
TESTFORGE_LOG_JSON=false
TESTFORGE_LOG_FILE=

# NO_COLOR is honoured as well, per the de facto standard.

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------

TESTFORGE_DIAG_ON_FAILURE=true
TESTFORGE_DIAG_GPU=true

# ---------------------------------------------------------------------------
# REST API and dashboard
# ---------------------------------------------------------------------------

# Loopback by default. The API has no authentication and POST /api/runs
# executes registered tests, so read docs/security.md before changing this.
TESTFORGE_SERVER_HOST=127.0.0.1
TESTFORGE_SERVER_PORT=8080

# ---------------------------------------------------------------------------
# Config file
# ---------------------------------------------------------------------------

# Overrides the default search (config/default.json).
TESTFORGE_CONFIG=
